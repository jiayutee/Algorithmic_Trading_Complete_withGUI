<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.algotrader.paper-execution</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jiayutee/Dev/Projects/Algorithmic_Trading_Complete_withGUI/scripts/run_execution.sh</string>
    </array>
    <!-- start at login, and restart if it dies; the service holds a lease so a restart can never double-trade -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>/Users/jiayutee/Dev/Projects/Algorithmic_Trading_Complete_withGUI/logs/execution-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jiayutee/Dev/Projects/Algorithmic_Trading_Complete_withGUI/logs/execution-launchd.log</string>
</dict>
</plist>
