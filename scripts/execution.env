# Settings for the always-on PAPER execution service (read by scripts/run_execution.sh).
# Edit, then apply with:  launchctl kickstart -k gui/$(id -u)/com.algotrader.paper-execution
#
# Chosen defaults: the Trend Filter is the only rule with any evidence (Phases 6.7-6.9: it reduced drawdown, it did NOT
# show extra return), on DAILY bars of large crypto pairs, the setting it was validated on. Paper money only.
SYMBOLS="BTCUSDT ETHUSDT SOLUSDT BNBUSDT"
STRATEGY="Trend Filter (28d)"
INTERVAL="1d"
ALLOCATION="0.15"        # fraction of equity per symbol while its signal is on (4 symbols x 15% = 60% invested at most)
POLL_SECONDS="300"
TREND_OVERLAY=""         # set to 1 to also wrap the strategy in the trend overlay (redundant for Trend Filter)
